---
// 官网产品演示使用展示数据，与真实账号及本机 Codex 连接无关。
import { translator, type Locale } from '../i18n';

import Mark from './Mark.astro';
import DemoWorkspace from './DemoWorkspace.astro';
import Icon from './Icon.astro';
import QuotaPopover from './QuotaPopover.astro';
import '../styles/demo-current.css';
import '../styles/demo-mobile.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'zh-CN';
const t = translator(locale);
const keyboardRows = [
  ['esc', '◉', '☀', '☀', '▦', '⌕', '◖', '◀', '▶', '▶', '◀', '◖', '◗', '◉'],
  ['~', '1', '2', '3', '4', '5', '6', '7', '8', '9', '0', '−', '=', 'delete'],
  ['tab', 'Q', 'W', 'E', 'R', 'T', 'Y', 'U', 'I', 'O', 'P', '[', ']', '\\'],
  ['caps', 'A', 'S', 'D', 'F', 'G', 'H', 'J', 'K', 'L', ';', '’', 'return'],
  ['shift', 'Z', 'X', 'C', 'V', 'B', 'N', 'M', ',', '.', '/', 'shift'],
  ['fn', '⌃', '⌥', '⌘', '', '⌘', '⌥', '◀', '▲', '▶'],
];
---

<div class="product-scene" data-platform="mac" id="product-demo">
  <div class="scene-glow"></div>
  <div class="laptop">
    <div class="laptop-lid">
      <div class="laptop-display">
        <div class="laptop-lid-shell" aria-hidden="true">
          <Mark size={48} />
        </div>
        <div class="laptop-screen-off" aria-hidden="true"></div>
        <div class="laptop-camera">
          <i></i>
        </div>
        <div class="desktop-wallpaper">
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div class="demo-systembar">
          <span>
            <Icon name="spark" size={12} /> <b>Codex Pulse</b>
            <span class="systembar-word">{t('文件　编辑　视图')}</span>
          </span>
          <span>
            <button
              type="button"
              class="systembar-pulse"
              data-demo-peek-trigger
              aria-label={t('查看菜单栏额度卡片')}
              aria-expanded="false"
              aria-controls="hero-quota-preview"
            >
              <Mark size={18} /> 72%
            </button>
            <span class="systembar-status">◒　▰</span>
            <span>{t('周六 10:24')}</span>
          </span>
        </div>
        <DemoWorkspace locale={locale} />
        <QuotaPopover locale={locale} class="hero-popover" preview current />
        <div class="windows-rail">
          <Mark size={19} />
          {[
            { percent: 72, color: '#51c986' },
            { percent: 96, color: '#51c986' },
          ].map((meter) => (
            <span class="rail-meter" style={`--rail-color:${meter.color}`}>
              <svg class="rail-progress" viewBox="0 0 36 36" aria-hidden="true">
                <circle class="rail-track" cx="18" cy="18" r="15" pathLength="100" />
                <circle
                  class="rail-fill"
                  cx="18"
                  cy="18"
                  r="15"
                  pathLength="100"
                  stroke-dasharray={`${meter.percent} ${100 - meter.percent}`}
                />
              </svg>
              <b class="rail-value">
                {meter.percent}
                <small>%</small>
              </b>
            </span>
          ))}
          <b>2.9M</b>
        </div>
      </div>
      <div class="laptop-lid-back" aria-hidden="true"></div>
      <div class="laptop-lid-side lid-side-left" aria-hidden="true"></div>
      <div class="laptop-lid-side lid-side-right" aria-hidden="true"></div>
      <div class="laptop-lid-edge lid-edge-top" aria-hidden="true"></div>
      <div class="laptop-lid-edge lid-edge-bottom" aria-hidden="true"></div>
    </div>
    <div class="laptop-keyboard" aria-hidden="true">
      <div class="laptop-keys">
        {keyboardRows.map((row, rowIndex) => (
          <div class="laptop-key-row" data-row={rowIndex}>
            {row.map((label) => (
              <span
                class:list={[
                  'laptop-key',
                  { 'key-wide': label.length > 1, 'key-space': label === '' },
                ]}
              >
                {label}
              </span>
            ))}
          </div>
        ))}
      </div>
      <div class="laptop-trackpad"></div>
      <div class="laptop-deck-front"></div>
      <div class="laptop-deck-side deck-side-left"></div>
      <div class="laptop-deck-side deck-side-right"></div>
      <div class="laptop-deck-under"></div>
    </div>
    <div class="laptop-base">
      <i></i>
    </div>
    <div class="laptop-bottom"></div>
  </div>
  <img
    src={`${base}assets/app.svg`}
    width="136"
    height="136"
    class="hero-app-icon"
    alt={t('Codex Pulse 应用图标')}
  />
</div>
