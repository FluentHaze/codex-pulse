---
// 按当前语言组合官网各内容区块；交互逻辑统一由页面末尾的 site 脚本初始化。
import { translator, locales, localePath, type Locale } from '../i18n';

import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import Icon from './Icon.astro';
import ProductDemo from './ProductDemo.astro';
import QuotaPopover from './QuotaPopover.astro';
import UsageChart from './UsageChart.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const locale = Astro.props.locale ?? 'zh-CN';
const repo = 'https://github.com/FluentHaze/codex-pulse';
const releases = `${repo}/releases`;
const readme = locale === 'zh-CN' ? repo : `${repo}/blob/main/docs/README.${locale}.md`;
const dataAnchor = locale === 'zh-CN' ? '数据和连接' : 'data-and-connection';
const t = translator(locale);
const steps = [
  {
    number: '01',
    title: t('移入应用程序'),
    text: t('打开 DMG，将 Codex Pulse 拖入「应用程序」。使用 ZIP 时，请先解压。'),
    kind: 'install',
  },
  {
    number: '02',
    title: t('先尝试打开一次'),
    text: t('双击 Codex Pulse。出现无法验证开发者的提示时，选择「取消」或「完成」。'),
    kind: 'open',
  },
  {
    number: '03',
    title: t('前往隐私与安全性'),
    text: t('打开「系统设置 → 隐私与安全性」，向下找到「安全性」。'),
    kind: 'settings',
  },
  {
    number: '04',
    title: t('点击「仍要打开」'),
    text: t('找到 Codex Pulse 被阻止的提示，按要求验证密码或 Touch ID，再次确认「打开」。'),
    kind: 'allow',
  },
];

interface Props {
  locale?: Locale;
}
---

<Base locale={locale}>
  <header class="site-header">
    <nav class="nav-shell" aria-label={t('主导航')}>
      <a class="wordmark" href="#" aria-label={t('Codex Pulse 首页')}>
        <Mark size={29} />
        <span>Codex Pulse</span>
      </a>
      <div class="nav-links" id="nav-links">
        <a href="#overview">{t('概览')}</a>
        <a href="#features">{t('功能')}</a>
        <a href="#install">{t('安装指引')}</a>
        <a href={`${base}flow/`} target="_blank" rel="noopener noreferrer">
          {t('项目流程图')}
        </a>
        <a href={readme} target="_blank" rel="noopener noreferrer">
          GitHub <Icon name="arrow" size={12} />
        </a>
      </div>
      <div class="display-controls">
        <div class="preference-menu" data-preference="language">
          <button
            class="preference-trigger"
            type="button"
            aria-label={t('语言')}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="language-menu"
          >
            <span aria-hidden="true">◎</span>
            <span data-language-label>{locales.find((item) => item.code === locale)?.label}</span>
            <span class="preference-chevron" aria-hidden="true"></span>
          </button>
          <div
            class="preference-options"
            id="language-menu"
            role="menu"
            aria-label={t('语言')}
            hidden
          >
            {locales.map((item) => (
              <a
                role="menuitemradio"
                aria-checked={item.code === locale ? 'true' : 'false'}
                lang={item.code}
                href={localePath(item.code)}
                data-language={item.code}
              >
                <span>{item.label}</span>
                <span class="preference-check" aria-hidden="true">
                  ✓
                </span>
              </a>
            ))}
          </div>
        </div>
        <div class="preference-menu" data-preference="theme">
          <button
            class="preference-trigger"
            type="button"
            aria-label={t('主题')}
            aria-haspopup="menu"
            aria-expanded="false"
            aria-controls="theme-menu"
          >
            <span aria-hidden="true">◐</span>
            <span data-theme-label>{t('跟随系统')}</span>
            <span class="preference-chevron" aria-hidden="true"></span>
          </button>
          <div class="preference-options" id="theme-menu" role="menu" aria-label={t('主题')} hidden>
            {[
              { value: 'system', label: t('跟随系统') },
              { value: 'light', label: t('浅色') },
              { value: 'dark', label: t('深色') },
            ].map((item) => (
              <button
                type="button"
                role="menuitemradio"
                aria-checked={item.value === 'system' ? 'true' : 'false'}
                data-theme-option={item.value}
              >
                <span>{item.label}</span>
                <span class="preference-check" aria-hidden="true">
                  ✓
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>
      <a class="button button-small" href="#download">
        {t('免费下载')}
      </a>
      <button
        class="menu-toggle"
        aria-label={t('展开导航')}
        aria-expanded="false"
        aria-controls="nav-links"
      >
        <Icon name="menu" />
      </button>
    </nav>
  </header>
  <aside class="language-suggestion" hidden aria-label={t('语言')}>
    <span data-language-suggestion-text></span>
    <a data-language-suggestion-link class="text-link"></a>
    <button type="button" data-language-suggestion-close aria-label={t('关闭')}>
      ×
    </button>
  </aside>
  <main id="main">
    <section class="hero">
      <div class="hero-copy" id="overview">
        <p class="eyebrow">{t('为专注而生')}</p>
        <h1>
          {t('额度，心中有数。')}
          <span>{t('专注，始终在线。')}</span>
        </h1>
        <p class="hero-description">{t('在菜单栏看额度，在每一轮看用量。')}</p>
        <div class="hero-actions">
          <a class="button button-large" href="#download">
            <Icon name="download" size={19} />
            <span data-primary-download>{t('下载 Mac 版')}</span>
          </a>
          <a class="text-link" href="#download">
            <span data-secondary-download>{t('Windows 版')}</span>
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <p class="hero-meta">
          {t('开源免费')}
          <span>·</span>
          {t('macOS 与 Windows')}
        </p>
      </div>
      <ProductDemo locale={locale} />
      <div class="product-caption">
        <div class="platform-switch" role="group" aria-label={t('产品界面示意平台')}>
          <button type="button" data-platform-button="mac" aria-pressed="true">
            macOS
          </button>
          <button type="button" data-platform-button="windows" aria-pressed="false">
            Windows
          </button>
        </div>
        <p>
          {t('界面与用量数据为功能示意')}
          <span class="demo-caption-hint">{t('点击侧栏，体验四个界面。')}</span>
        </p>
      </div>
    </section>
    <section class="features section-shell">
      <div class="section-intro" id="features">
        <p class="eyebrow">{t('轻巧，却很周到。')}</p>
        <h2>
          {t('少一点打断。')}
          <br />
          {t('多一点心中有数。')}
        </h2>
        <p>
          {t('把注意力留给创作，')}
          <br class="mobile-break" /> {t('把额度与用量交给 Pulse。')}
        </p>
      </div>
      <div class="feature-grid">
        <article class="feature-card menubar-feature">
          <div class="feature-copy">
            <span class="feature-kicker">{t('随时看一眼')}</span>
            <h3>
              {t('抬眼之间，')}
              <br />
              {t('额度尽知。')}
            </h3>
            <p>
              {t('剩余百分比常驻 Mac 菜单栏。')}
              <br />
              {t('移入展开，点击直达详情。')}
            </p>
          </div>
          <div class="menubar-art">
            <div class="feature-systembar">
              <Mark size={20} />
              <b>88%</b>
              <span>{t('◒　▰　周六 10:24')}</span>
            </div>
            <QuotaPopover locale={locale} />
          </div>
        </article>
        <article class="feature-card token-feature">
          <div class="feature-copy">
            <span class="feature-kicker">{t('每一轮都有迹可循')}</span>
            <h3>
              {t('每一轮，')}
              <br />
              {t('都看得清。')}
            </h3>
            <p>
              {t('输入、输出、缓存与推理，按轮查看。')}
              <br />
              {t('今日对比昨日，点击轮次展开消息。')}
            </p>
          </div>
          <div class="token-art">
            <div class="token-chart-card">
              <div class="token-chart-title">
                <div>
                  <small>{t('本机已记录')}</small>
                  <h4>{t('今日 Token 用量')}</h4>
                </div>
                <strong>
                  2.4<span>M Token</span>
                </strong>
              </div>

              <UsageChart locale={locale} />
            </div>
            <div class="token-breakdown">
              <span>
                <i></i>
                {t('输入')}
                <b>2.1M Token</b>
              </span>
              <span>
                <i></i>
                {t('输出')}
                <b>300K Token</b>
              </span>
              <span>
                <i></i>
                {t('缓存')}
                <b>1.8M Token</b>
              </span>
            </div>
          </div>
        </article>
      </div>
      <div class="feature-notes">
        <div>
          <Icon name="clock" size={23} />
          <p>
            <b>{t('按你的节奏更新')}</b>
            <span>{t('跟随进行中的聊天，保持用量稳定更新。')}</span>
          </p>
        </div>
        <div>
          <Icon name="spark" size={23} />
          <p>
            <b>{t('临界时，提醒你')}</b>
            <span>{t('低额度与恢复通知，少一次意外打断。')}</span>
          </p>
        </div>
        <div>
          <Icon name="windows" size={22} />
          <p>
            <b>{t('两种桌面，一份从容')}</b>
            <span>{t('Mac 菜单栏，Windows 桌面悬浮窗。')}</span>
          </p>
        </div>
      </div>
    </section>
    <section class="privacy-section">
      <div class="section-shell" id="privacy">
        <p class="eyebrow">{t('本机读取，安心专注。')}</p>
        <h2>
          {t('你的数据，')}
          <br class="mobile-break" /> {t('留在你的电脑。')}
        </h2>
        <p class="privacy-lead">
          {t('通过本机 Codex 读取额度。')}
          <br />
          {t('不复制、不保存登录 Token，不发送模型对话。')}
        </p>
        <div class="privacy-art" aria-hidden="true">
          <div class="privacy-window left">
            <i></i>
            <i></i>
            <i></i>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="privacy-window right">
            <i></i>
            <i></i>
            <i></i>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="privacy-halo"></div>
          <div class="shield">
            <svg viewBox="0 0 160 184">
              <defs>
                <linearGradient id="shield-line" x1="0" y1="0" x2="1" y2="1">
                  <stop stop-color="#a4daff" />
                  <stop offset=".5" stop-color="#148cff" />
                  <stop offset="1" stop-color="#a4daff" />
                </linearGradient>
              </defs>
              <path
                d="M80 7 148 32v55c0 40-43 73-68 89-25-16-68-49-68-89V32Z"
                fill="#1088ff16"
                stroke="url(#shield-line)"
                stroke-width="2"
              />
              <path
                d="M80 15 141 37v50c0 35-37 65-61 81-24-16-61-46-61-81V37Z"
                fill="none"
                stroke="#429dff"
                stroke-opacity=".4"
              />
            </svg>
            <Icon name="lock" size={55} />
          </div>
        </div>
        <div class="privacy-footnotes">
          <span>
            <Icon name="check" size={16} />
            {t('账号额度通过本机 app-server 读取')}
          </span>
          <a href={`${readme}#${dataAnchor}`} target="_blank" rel="noopener noreferrer">
            {t('查看数据说明')} <Icon name="arrow" size={15} />
          </a>
        </div>
      </div>
    </section>
    <section class="download-section section-shell">
      <img
        id="download"
        class="download-icon"
        src={`${base}assets/app.svg`}
        width="82"
        height="82"
        loading="lazy"
        alt={t('Codex Pulse 图标')}
      />
      <p class="eyebrow">{t('准备好，继续创造。')}</p>
      <h2>
        {t('让专注，')}
        <br class="mobile-break" /> {t('多一点从容。')}
      </h2>
      <p class="section-description">{t('你的下一行代码，值得更专注的时刻。')}</p>
      <div class="download-grid">
        <article class="download-card" data-download-card="mac-arm64">
          <Icon name="mac" size={28} />
          <h3>
            Mac · Apple Silicon <small data-download-version></small>
          </h3>
          <p>{t('M 系列芯片')}</p>
          <a
            class="button button-secondary"
            data-download="mac-arm64-dmg"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('前往 GitHub 下载')} <Icon name="download" size={16} />
          </a>
          <a
            class="download-alternative"
            data-download="mac-arm64-zip"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('ZIP 压缩包')} <Icon name="arrow" size={12} />
          </a>
        </article>
        <article class="download-card" data-download-card="mac-x64">
          <Icon name="mac" size={28} />
          <h3>
            Mac · Intel <small data-download-version></small>
          </h3>
          <p>{t('Intel 处理器')}</p>
          <a
            class="button button-secondary"
            data-download="mac-x64-dmg"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('前往 GitHub 下载')} <Icon name="download" size={16} />
          </a>
          <a
            class="download-alternative"
            data-download="mac-x64-zip"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('ZIP 压缩包')} <Icon name="arrow" size={12} />
          </a>
        </article>
        <article class="download-card" data-download-card="win-x64">
          <Icon name="windows" size={28} />
          <h3>
            Windows <small data-download-version></small>
          </h3>
          <p>{t('x64 · 安装版，支持应用内更新')}</p>
          <a
            class="button button-secondary"
            data-download="win-x64-setup"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('前往 GitHub 下载')} <Icon name="download" size={16} />
          </a>
          <a
            class="download-alternative"
            data-download="win-x64-portable"
            href={releases}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t('便携版 · 手动更新')} <Icon name="arrow" size={12} />
          </a>
        </article>
      </div>
      <p class="release-status" id="release-status" aria-live="polite">
        {t('安装包与更新记录，请在 GitHub Releases 查看。')}
      </p>
      <p class="download-prerequisite">
        {t('需要已安装并登录 ChatGPT 账号的 Codex。')}
        <br />
        {t('Mac 版尚未经过 Apple 公证，首次打开请按下方指引操作。')}
      </p>
      <a href="#install" class="text-link install-link">
        {t('Mac 首次安装指引')} <span>↓</span>
      </a>
    </section>
    <section class="install-section">
      <div class="section-shell">
        <div class="section-intro" id="install">
          <p class="eyebrow">{t('从下载到专注')}</p>
          <h2>
            {t('Mac 首次打开，')}
            <br />
            {t('只需这几步。')}
          </h2>
          <p>
            {t('当前使用本地签名，尚未经过 Apple 公证。')}
            <br />
            {t('仅在确认下载来源可信且文件未被篡改时操作。')}
          </p>
        </div>
        <div class="install-grid">
          {steps.map((step) => (
            <article class="install-card">
              <div class="step-heading">
                <span>{step.number}</span>
                <h3>{step.title}</h3>
              </div>
              <p>{step.text}</p>
              <div class:list={['step-art', `step-${step.kind}`]} aria-hidden="true">
                {step.kind === 'install' ? (
                  <>
                    <div class="mini-window-title">
                      <i></i>
                      <i></i>
                      <i></i>
                      <span>Codex Pulse</span>
                    </div>
                    <div class="drag-demo">
                      <img
                        src={`${base}assets/app.svg`}
                        width="56"
                        height="56"
                        loading="lazy"
                        alt=""
                      />
                      <span>→</span>
                      <div class="applications-folder">A</div>
                    </div>
                    <div class="drag-labels">
                      <span>Codex Pulse</span>
                      <span>{t('应用程序')}</span>
                    </div>
                  </>
                ) : step.kind === 'open' ? (
                  <div class="open-notice">
                    <Icon name="shield" size={32} />
                    <b>{t('无法验证开发者')}</b>
                    <span>{t('Codex Pulse 尚未经过 Apple 公证。')}</span>
                    <div>
                      <i>{t('取消')}</i>
                      <i>{t('完成')}</i>
                    </div>
                  </div>
                ) : step.kind === 'settings' ? (
                  <div class="settings-demo">
                    <aside>
                      <span>{t('通用')}</span>
                      <span>{t('外观')}</span>
                      <b>
                        <Icon name="shield" size={12} />
                        {t('隐私与安全性')}
                      </b>
                    </aside>
                    <div>
                      <h4>{t('隐私与安全性')}</h4>
                      <span>{t('安全性')}</span>
                      <i></i>
                      <i></i>
                    </div>
                  </div>
                ) : (
                  <div class="allow-demo">
                    <Icon name="shield" size={26} />
                    <b>{t('安全性')}</b>
                    <p>
                      {t('已阻止 Codex Pulse 打开，')}
                      <br />
                      {t('因为无法验证开发者。')}
                    </p>
                    <span class="allow-button">{t('仍要打开')}</span>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
        <p class="install-note">
          <Icon name="shield" size={18} />
          <span>
            {t('若仍提示「已损坏」或没有「仍要打开」，请使用最新版并')}
            <a href={`${repo}/issues`} target="_blank" rel="noopener noreferrer">
              {t('反馈问题')}
            </a>
            {t('。不需要关闭系统安全保护。')}
          </span>
        </p>
        <a
          class="text-link apple-guide"
          href={`https://support.apple.com/${{ 'zh-CN': 'zh-cn', 'zh-TW': 'zh-tw', en: 'en-us', ja: 'ja-jp', ko: 'ko-kr' }[locale]}/102445`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t('Apple 官方操作说明')} <Icon name="arrow" size={15} />
        </a>
      </div>
    </section>
    <section class="faq-section section-shell">
      <div>
        <p class="eyebrow">{t('还有一些，你可能想知道。')}</p>
        <h2>
          {t('简单使用，')}
          <br />
          {t('清楚了解。')}
        </h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>
            {t('开始使用前，需要准备什么？')}
            <span>+</span>
          </summary>
          <p>
            {t(
              '先安装 Codex，并使用 ChatGPT 账号登录。Pulse 会自动查找本机 Codex 可执行文件；如果没有找到，可以在设置中手动选择路径。',
            )}
          </p>
        </details>
        <details>
          <summary>
            {t('为什么用量数字与账单可能不同？')}
            <span>+</span>
          </summary>
          <p>
            {t(
              '额度以 Codex 服务端返回的窗口数据为准。Token 统计来自本机已记录的会话事件，可能不完整，也不等同于账单或全部设备的用量。',
            )}
          </p>
        </details>
        <details>
          <summary>
            {t('Mac 上如何显示桌面悬浮窗？')}
            <span>+</span>
          </summary>
          <p>
            {t(
              'Mac 默认使用菜单栏显示额度。打开详情中的「偏好设置 → 悬浮窗」，开启「显示桌面悬浮窗」即可。菜单栏点击打开菜单，移入时展开额度卡片。',
            )}
          </p>
        </details>
        <details>
          <summary>
            {t('它是 OpenAI 官方应用吗？')}
            <span>+</span>
          </summary>
          <p>
            {t(
              'Codex Pulse 是独立的开源项目，并非 OpenAI 官方产品，也与 Apple 没有隶属关系。你可以在 GitHub 查看源码、发布记录并反馈问题。',
            )}
          </p>
        </details>
      </div>
    </section>
  </main>
  <footer class="site-footer section-shell">
    <div class="footer-top">
      <a class="wordmark" href="#">
        <Mark size={25} />
        <span>Codex Pulse</span>
      </a>
      <div>
        <a href={readme} target="_blank" rel="noopener noreferrer">
          GitHub <Icon name="arrow" size={12} />
        </a>
        <a href="#download">{t('下载')}</a>
