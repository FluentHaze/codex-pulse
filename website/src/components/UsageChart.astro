---
import { translator, type Locale } from '../i18n';
interface Props {
  locale?: Locale;
  presentation?: boolean;
  compact?: boolean;
}
const t = translator(Astro.props.locale ?? 'zh-CN');
const { presentation = false, compact = false } = Astro.props;
const today = [
  3, 2, 0, 0, 0, 0, 4, 9, 18, 45, 72, 55, 38, 61, 86, 65, 47, 28, 41, 59, 36, 22, 14, 5,
];
const yesterday = [
  4, 3, 1, 0, 0, 1, 2, 12, 28, 39, 56, 71, 44, 51, 67, 49, 38, 53, 29, 43, 61, 36, 21, 9,
];
const path = yesterday
  .map((value, index) => `${index ? 'L' : 'M'}${(index + 0.5) * 100},${1000 - value * 10}`)
  .join(' ');
// Monotone tangents preserve each hourly value without inventing peaks between samples.
const points = yesterday.map((value, index) => ({ x: (index + 0.5) * 100, y: 1000 - value * 10 }));
const slopes = points.slice(1).map((point, index) => (point.y - points[index].y) / 100);
const tangents = points.map((_, index) => {
  if (index === 0) return slopes[0];
  if (index === points.length - 1) return slopes[slopes.length - 1];
  const before = slopes[index - 1];
  const after = slopes[index];
  return before * after <= 0 ? 0 : (2 * before * after) / (before + after);
});
const smoothPath = points
  .map((point, index) => {
    if (!index) return 'M' + point.x + ',' + point.y;
    const previous = points[index - 1];
    const third = (point.x - previous.x) / 3;
    return (
      'C' +
      (previous.x + third) +
      ',' +
      (previous.y + tangents[index - 1] * third) +
      ' ' +
      (point.x - third) +
      ',' +
      (point.y - tangents[index] * third) +
      ' ' +
      point.x +
      ',' +
      point.y
    );
  })
  .join(' ');
---

<div
  class:list={[
    'usage-chart comparison-chart',
    { 'presentation-chart': presentation, 'compact-chart': compact },
  ]}
  aria-label={t('今日与昨日每小时 Token 对比，示例数据')}
>
  <div class="chart-lines">
    <span>100K</span>
    <span>50K</span>
    <span>0</span>
  </div>
  <div class="chart-bars">
    <svg
      class="chart-yesterday"
      viewBox="0 0 2400 1000"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {presentation && (
        <path class="trend-underlay" d={smoothPath} vector-effect="non-scaling-stroke" />
      )}
      <path
        class="trend-line"
        d={presentation ? smoothPath : path}
        vector-effect="non-scaling-stroke"
      />
      {presentation &&
        points
          .filter((_, index) => index % 4 === 0 || index === points.length - 1)
          .map((point) => (
            <svg
              x={point.x - 24}
              y={point.y - 30}
              width="48"
              height="60"
              viewBox="0 0 12 12"
              preserveAspectRatio="xMidYMid meet"
              overflow="visible"
            >
              <circle class="trend-node" cx="6" cy="6" r="3.5" vector-effect="non-scaling-stroke" />
            </svg>
          ))}
    </svg>
    {today.map((height, index) => (
      <button
        type="button"
        class="chart-bar"
        style={`--bar-height:${height}%;--bar-delay:${index * 18}ms`}
        aria-label={`${String(index).padStart(2, '0')}:00 · ${t('今日')} ${height}K Token · ${t('昨日')} ${yesterday[index]}K Token`}
      >
        <span class="demo-chart-tooltip">
          <b>{String(index).padStart(2, '0')}:00</b>
          <span>
            {t('今日')} <strong>{height}K Token</strong>
          </span>
          <span>
            {t('昨日')} <strong>{yesterday[index]}K Token</strong>
          </span>
        </span>
      </button>
    ))}
  </div>
  <div class="chart-hours">
    <span>00</span>
    <span>04</span>
    <span>08</span>
    <span>12</span>
    <span>16</span>
    <span>20</span>
    <span>23</span>
  </div>
  <div class="comparison-legend">
    <span>
      <i></i>
      {t('今日')}
    </span>
    <span>
      <i></i>
      {t('昨日')}
    </span>
    <small>Token</small>
  </div>
</div>

<style>
  .presentation-chart {
    --demo-surface: #fff;
    --demo-ink: #1d1d1f;
    --demo-muted: #6e6e73;
    --demo-line: #e5e5ea;
  }
  .presentation-chart .chart-bars {
    gap: 0;
  }
  .presentation-chart .chart-bar {
    margin-inline: 3px;
    border-radius: 4px 4px 0 0;
  }
  .presentation-chart .chart-yesterday .trend-underlay {
    stroke: #f5f5f7;
    stroke-width: 7;
    stroke-dasharray: none;
  }
  .presentation-chart .chart-yesterday .trend-line {
    stroke: #747b89;
    stroke-width: 2.5;
    stroke-dasharray: none;
    stroke-linejoin: round;
  }
  .presentation-chart .trend-node {
    fill: #747b89;
    stroke: #f5f5f7;
    stroke-width: 2;
  }
  .presentation-chart .comparison-legend {
    gap: 22px;
    font-size: 12px;
  }
  .presentation-chart .comparison-legend > span {
    gap: 7px;
  }
  .presentation-chart .comparison-legend i {
    width: 9px;
    height: 9px;
    border-radius: 3px;
  }
  .presentation-chart .comparison-legend span:nth-child(2) i {
    width: 20px;
    height: 0;
    border-top: 2.5px solid #747b89;
  }
  .presentation-chart .chart-lines span,
  .presentation-chart .chart-hours {
    font-size: 10px;
    color: #747b89;
  }
  .presentation-chart .demo-chart-tooltip {
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 12px;
    box-shadow: 0 8px 28px #17274416;
  }
  @media (max-width: 600px) {
    .presentation-chart .chart-bar {
      margin-inline: 1.5px;
      border-radius: 3px 3px 0 0;
    }
    .presentation-chart .comparison-legend {
      font-size: 11px;
    }
  }
  .presentation-chart.compact-chart .chart-bar {
    margin-inline: 1px;
    border-radius: 2px 2px 0 0;
  }
  .presentation-chart.compact-chart .chart-yesterday .trend-line {
    stroke-width: 1.6;
  }
  .presentation-chart.compact-chart .chart-yesterday .trend-underlay {
    stroke-width: 4;
  }
  .presentation-chart.compact-chart .comparison-legend {
    gap: 9px;
    font-size: 6px;
  }
  .presentation-chart.compact-chart .comparison-legend i {
    width: 5px;
    height: 5px;
  }
  .presentation-chart.compact-chart .comparison-legend span:nth-child(2) i {
    width: 12px;
    height: 0;
    border-top-width: 1.6px;
  }
  .presentation-chart.compact-chart .chart-lines span,
  .presentation-chart.compact-chart .chart-hours {
    font-size: 6px;
  }
  .presentation-chart.compact-chart .demo-chart-tooltip {
    font-size: 8px;
    padding: 7px 9px;
    border-radius: 7px;
  }
</style>
