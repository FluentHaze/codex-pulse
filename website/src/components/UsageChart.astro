---
// 官网静态用量示意图；图形数值用于演示布局，不代表用户账单。
import { translator, type Locale } from '../i18n';

const bars = [
  8, 11, 17, 25, 21, 36, 45, 59, 71, 83, 96, 88, 65, 42, 25, 16, 13, 18, 32, 45, 52, 38, 22, 14, 10,
  6, 3, 5,
];

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? 'zh-CN';
const t = translator(locale);
---

<div class="usage-chart" aria-label={t('Token 用量示意图，示例数据')}>
  <div class="chart-lines">
    <span>4k</span>
    <span>2k</span>
    <span>0</span>
  </div>
  <div class="chart-bars">
    {bars.map((height, i) => (
      <div class="chart-bar" style={`--bar-height:${height}%;--bar-delay:${i * 18}ms`}>
        <i></i>
      </div>
    ))}
  </div>
  <div class="chart-hours">
    <span>00:00</span>
    <span>04:00</span>
    <span>08:00</span>
    <span>12:00</span>
    <span>16:00</span>
    <span>20:00</span>
  </div>
</div>
