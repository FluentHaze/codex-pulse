---
import sourceMark from '../../../assets/mark.svg?raw';
const glyph = sourceMark.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  class={className}
  viewBox="0 0 128 128"
  fill="none"
  aria-hidden="true"
  set:html={glyph}
/>
