{
  "name": "codex-pulse",
  "version": "0.1.34",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "assets:dmg": "electron scripts/create-dmg-background.cjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "pack": "node scripts/pack.mjs all",
    "probe": "tsx scripts/probe.ts",
    "pack:mac": "node scripts/pack.mjs mac",
    "pack:all": "node scripts/pack.mjs all",
    "pack:win": "node scripts/pack.mjs win",
    "test:update-transport": "npm run build && electron scripts/test-update-fetch.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:icons": "electron scripts/create-icon.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.codexpulse.desktop",
    "productName": "Codex Pulse",
    "asarUnpack": [
      "dist-electron/**/*.js"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/app.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/app.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "${productName}",
      "background": "assets/dmg/background.png",
      "iconSize": 96,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 255,
          "y": 185,
          "type": "file"
        },
        {
          "x": 545,
          "y": 185,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 400,
          "y": 490,
          "type": "file",
          "path": "release/.dmg-assets/打开隐私与安全性.inetloc"
        }
      ]
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "beforePack": "scripts/prepare-mac-dmg.mjs",
    "afterSign": "scripts/verify-mac-signature.mjs",
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "FluentHaze",
      "repo": "codex-pulse"
    }
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
