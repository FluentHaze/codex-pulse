{
  "name": "codex-pulse",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "pack": "node scripts/pack.mjs all",
    "probe": "tsx scripts/probe.ts",
    "pack:mac": "node scripts/pack.mjs mac",
    "pack:all": "node scripts/pack.mjs all",
    "pack:win": "node scripts/pack.mjs win"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.codexpulse.desktop",
    "productName": "Codex Pulse",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/app.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "afterSign": "scripts/verify-mac-signature.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
